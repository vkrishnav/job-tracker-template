# Job data file (default: ~/Documents/job-data.json). Holds jobs, discovered feed, journal, runs, signals, outbox, config.
# JOB_DATA_PATH=/Users/yourname/Documents/job-data.json

# API server port (default 3001). The Vite dev server proxies /api → this port (see vite.config.js),
# so the frontend needs no change. Set VITE_API_URL only if the API lives on another origin.
# PORT=3001
# VITE_API_URL=http://localhost:3001/api

# Turn off the in-process fetch/scan scheduler (intervals live in config.fetch_interval_min / scan_interval_min)
# AGENT_SCHEDULER=off

# Gmail SMTP for sending from the Outbox. If unset, the server reuses ~/Documents/GIT/gmail-mcp/.env.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# DEFAULT_FROM_NAME=Your Name
# GMAIL_ENV_FILE=/path/to/gmail-mcp/.env

# Where digest markdown files are written (default ~/Documents)
# DIGEST_DIR=/Users/yourname/Documents

# overleaf-resume MCP server (mcp/overleaf-resume). LaTeX resume working copy + hosted compile + Overleaf handoff.
# RESUME_TEX_PATH=/Users/yourname/Documents/resume/Vamsi_Resume.tex
# RESUME_PDF_PATH=/Users/yourname/Documents/resume/Vamsi_Resume.pdf
# OVERLEAF_HTML_PATH=/Users/yourname/Documents/resume/open-in-overleaf.html
# RESUME_LATEX_ENGINE=pdflatex   # pdflatex | xelatex | lualatex
