{
  "name": "job-tracker-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "agent": "node agents/run.mjs",
    "agent:fetch": "node agents/run.mjs fetch",
    "agent:scan": "node agents/run.mjs scan",
    "agent:digest": "node agents/run.mjs digest",
    "agent:all": "node agents/run.mjs all",
    "agent:status": "node agents/run.mjs status",
    "agent:jobspy": "sh -c '.venv-jobspy/bin/python agents/jobspy_fetch.py > /tmp/jobspy.json && node agents/run.mjs ingest-discovered /tmp/jobspy.json --source=jobspy'",
    "launchd:install": "sh scripts/install-launchd.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "*",
    "express": "*",
    "lucide-react": "^1.12.0",
    "nodemailer": "^10.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "*",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.10"
  }
}
